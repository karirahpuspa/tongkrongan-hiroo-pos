# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env.
PORT=4000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Isi dengan string acak minimal 32 karakter (contoh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=GANTI_DENGAN_SECRET_ACAK_MINIMAL_32_KARAKTER

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tongkrongan_hiroo_pos

# Password akun awal untuk `npm run seed` (hanya untuk pengembangan lokal)
SEED_OWNER_PASSWORD=owner123
SEED_CASHIER_PASSWORD=kasir123

# Google Sheets (diisi pada tahap Google Sheets)
GOOGLE_SHEETS_ID=
GOOGLE_SHEET_TAB_NAME=Transaksi
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
